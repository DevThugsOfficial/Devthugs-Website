# Vercel Environment Variables (Production + Preview)
# Copy these into: Project → Settings → Environment Variables
#
# REQUIRED
APP_NAME=DevThugs
APP_ENV=production
APP_DEBUG=true
APP_KEY=base64:HQ0GUVj4BpxdVc/rChwlUBQgcemVeui0sHJZEIv7JbE=
APP_URL=https://YOUR-PROJECT.vercel.app

# Laravel serverless temp paths (REQUIRED on Vercel)
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
VIEW_COMPILED_PATH=/tmp
LOG_CHANNEL=stderr

# Session/cache must NOT use database on first boot (REQUIRED)
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Supabase Postgres (REQUIRED for chatbot / DB features)
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.mglzjzhzhkynqnwqfytg
DB_PASSWORD=REPLACE_WITH_YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

# Mail (REQUIRED for contact form on production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=devthugscompanyofficial@gmail.com
MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM_ADDRESS=devthugscompanyofficial@gmail.com
MAIL_FROM_NAME=DevThugs
CONTACT_RECEIVER_EMAIL=devthugscompanyofficial@gmail.com

# Chatbot AI (keep off on Vercel unless you have a public AI API)
AI_CHAT_ENABLED=false
